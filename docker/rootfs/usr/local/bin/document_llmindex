#!/command/with-contenv /usr/bin/bash
# shellcheck shell=bash

set -e

cd "${UNIVERSALDOCUMENTS_SRC_DIR}"

if [[ $(id -u) == 0 ]]; then
	s6-setuidgid universaldocuments python3 manage.py document_llmindex "$@"
elif [[ $(id -un) == "universaldocuments" ]]; then
	python3 manage.py document_llmindex "$@"
else
	echo "Unknown user."
fi
