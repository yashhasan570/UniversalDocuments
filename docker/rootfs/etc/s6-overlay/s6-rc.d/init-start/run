#!/command/with-contenv /usr/bin/bash
# shellcheck shell=bash

declare -r log_prefix="[init-start]"

echo "${log_prefix} universaldocuments docker container starting..."

# Set some directories into environment for other steps to access via environment
# Sort of like variables for later
printf "/usr/src/universaldocuments/src" > /var/run/s6/container_environment/UNIVERSALDOCUMENTS_SRC_DIR
echo $(date +%s) > /var/run/s6/container_environment/UNIVERSALDOCUMENTS_START_TIME_S

# Check if we're starting as a non-root user
if [ "$(id --user)" != "0" ]; then
	printf "true" > /var/run/s6/container_environment/USER_IS_NON_ROOT
	echo "${log_prefix} universaldocuments docker container running under a user ($(id --user):$(id --group))"
else
	printf "/usr/src/universaldocuments" > /var/run/s6/container_environment/HOME
	echo "${log_prefix} universaldocuments docker container starting init as root"
fi
