# Have a look at the docs for documentation.
# https://docs.universaldocuments.com/configuration/

# Required services

#UNIVERSALDOCUMENTS_REDIS=redis://localhost:6379
#UNIVERSALDOCUMENTS_DBHOST=localhost
#UNIVERSALDOCUMENTS_DBPORT=5432
#UNIVERSALDOCUMENTS_DBNAME=universaldocuments
#UNIVERSALDOCUMENTS_DBUSER=universaldocuments
#UNIVERSALDOCUMENTS_DBPASS=universaldocuments
#UNIVERSALDOCUMENTS_DBSSLMODE=prefer

# Paths and folders

#UNIVERSALDOCUMENTS_CONSUMPTION_DIR=../consume
#UNIVERSALDOCUMENTS_DATA_DIR=../data
#UNIVERSALDOCUMENTS_EMPTY_TRASH_DIR=
#UNIVERSALDOCUMENTS_SCRATCH_DIR=/tmp/universaldocuments
#UNIVERSALDOCUMENTS_MEDIA_ROOT=../media
#UNIVERSALDOCUMENTS_STATICDIR=../static
#UNIVERSALDOCUMENTS_FILENAME_FORMAT=
#UNIVERSALDOCUMENTS_FILENAME_FORMAT_REMOVE_NONE=

# Security and hosting

# Required. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
UNIVERSALDOCUMENTS_SECRET_KEY=change-me
#UNIVERSALDOCUMENTS_URL=https://example.com
#UNIVERSALDOCUMENTS_CSRF_TRUSTED_ORIGINS=https://example.com # can be set using UNIVERSALDOCUMENTS_URL
#UNIVERSALDOCUMENTS_ALLOWED_HOSTS=example.com,www.example.com # can be set using UNIVERSALDOCUMENTS_URL
#UNIVERSALDOCUMENTS_CORS_ALLOWED_HOSTS=https://localhost:8080,https://example.com # can be set using UNIVERSALDOCUMENTS_URL
#UNIVERSALDOCUMENTS_FORCE_SCRIPT_NAME=
#UNIVERSALDOCUMENTS_STATIC_URL=/static/
#UNIVERSALDOCUMENTS_AUTO_LOGIN_USERNAME=
#UNIVERSALDOCUMENTS_COOKIE_PREFIX=
#UNIVERSALDOCUMENTS_ENABLE_HTTP_REMOTE_USER=false
#UNIVERSALDOCUMENTS_SOCIAL_ACCOUNT_SYNC_SUPERUSER_GROUP=
#UNIVERSALDOCUMENTS_SOCIAL_ACCOUNT_SYNC_STAFF_GROUP=

# OCR settings

#UNIVERSALDOCUMENTS_OCR_LANGUAGE=eng
#UNIVERSALDOCUMENTS_OCR_MODE=skip
#UNIVERSALDOCUMENTS_OCR_SKIP_ARCHIVE_FILE=never
#UNIVERSALDOCUMENTS_OCR_OUTPUT_TYPE=pdfa
#UNIVERSALDOCUMENTS_OCR_PAGES=1
#UNIVERSALDOCUMENTS_OCR_IMAGE_DPI=300
#UNIVERSALDOCUMENTS_OCR_CLEAN=clean
#UNIVERSALDOCUMENTS_OCR_DESKEW=true
#UNIVERSALDOCUMENTS_OCR_ROTATE_PAGES=true
#UNIVERSALDOCUMENTS_OCR_ROTATE_PAGES_THRESHOLD=12.0
#UNIVERSALDOCUMENTS_OCR_USER_ARGS={}

# Software tweaks

#UNIVERSALDOCUMENTS_TASK_WORKERS=1
#UNIVERSALDOCUMENTS_THREADS_PER_WORKER=1
#UNIVERSALDOCUMENTS_TIME_ZONE=UTC
#UNIVERSALDOCUMENTS_CONSUMER_POLLING_INTERVAL=10
#UNIVERSALDOCUMENTS_CONSUMER_DELETE_DUPLICATES=false
#UNIVERSALDOCUMENTS_CONSUMER_RECURSIVE=false
#UNIVERSALDOCUMENTS_CONSUMER_IGNORE_PATTERNS=[]  # Defaults are built in; add filename regexes, e.g. ["^\\.DS_Store$", "^desktop\\.ini$"]
#UNIVERSALDOCUMENTS_CONSUMER_SUBDIRS_AS_TAGS=false
#UNIVERSALDOCUMENTS_CONSUMER_ENABLE_BARCODES=false
#UNIVERSALDOCUMENTS_CONSUMER_BARCODE_STRING=PATCHT
#UNIVERSALDOCUMENTS_CONSUMER_BARCODE_UPSCALE=0.0
#UNIVERSALDOCUMENTS_CONSUMER_BARCODE_DPI=300
#UNIVERSALDOCUMENTS_CONSUMER_ENABLE_TAG_BARCODE=false
#UNIVERSALDOCUMENTS_CONSUMER_TAG_BARCODE_MAPPING={"TAG:(.*)": "\\g<1>"}
#UNIVERSALDOCUMENTS_CONSUMER_TAG_BARCODE_SPLIT=false
#UNIVERSALDOCUMENTS_CONSUMER_ENABLE_COLLATE_DOUBLE_SIDED=false
#UNIVERSALDOCUMENTS_CONSUMER_COLLATE_DOUBLE_SIDED_SUBDIR_NAME=double-sided
#UNIVERSALDOCUMENTS_CONSUMER_COLLATE_DOUBLE_SIDED_TIFF_SUPPORT=false
#UNIVERSALDOCUMENTS_PRE_CONSUME_SCRIPT=/path/to/an/arbitrary/script.sh
#UNIVERSALDOCUMENTS_POST_CONSUME_SCRIPT=/path/to/an/arbitrary/script.sh
#UNIVERSALDOCUMENTS_FILENAME_DATE_ORDER=YMD
#UNIVERSALDOCUMENTS_FILENAME_PARSE_TRANSFORMS=[]
#UNIVERSALDOCUMENTS_NUMBER_OF_SUGGESTED_DATES=5
#UNIVERSALDOCUMENTS_THUMBNAIL_FONT_NAME=
#UNIVERSALDOCUMENTS_IGNORE_DATES=
#UNIVERSALDOCUMENTS_ENABLE_UPDATE_CHECK=

# Tika settings

#UNIVERSALDOCUMENTS_TIKA_ENABLED=false
#UNIVERSALDOCUMENTS_TIKA_ENDPOINT=http://localhost:9998
#UNIVERSALDOCUMENTS_TIKA_GOTENBERG_ENDPOINT=http://localhost:3000
